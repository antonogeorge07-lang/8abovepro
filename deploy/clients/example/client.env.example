# 8above client deployment profile
#
# This file documents allowed configuration keys only.
# DO NOT place secrets here.

EIGHTABOVE_CLIENT_ID=example
EIGHTABOVE_CLIENT_NAME=Example Client

EIGHTABOVE_REGION=eu-west
EIGHTABOVE_DATA_RESIDENCY=EU

EIGHTABOVE_BRAND_NAME=8above
EIGHTABOVE_BASE_CURRENCY=EUR

EIGHTABOVE_FRONTEND_ORIGIN=https://example.8above.pro
EIGHTABOVE_API_ORIGIN=https://api.example.8above.pro

EIGHTABOVE_DEPLOYMENT_MODE=dedicated

EIGHTABOVE_FEATURE_ASSISTANT=true
EIGHTABOVE_FEATURE_AUDIT_EXPORT=true
EIGHTABOVE_FEATURE_GOVERNANCE=true
EIGHTABOVE_FEATURE_LEDGER_INGEST=true
